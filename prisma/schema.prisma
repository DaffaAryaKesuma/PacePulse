// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  stravaAthleteId    BigInt     @unique
  username           String?    @unique
  fullName           String
  avatarUrl          String?
  stravaAccessToken  String
  stravaRefreshToken String
  tokenExpiresAt     Int
  goalDistance       String     @default("Half Marathon")
  goalTimeSec        Int        @default(6300)
  currentPbSec       Int?
  thresholdHr        Int?
  maxHr              Int        @default(190)
  thresholdPaceSec   Int?
  trainingPhase      String     @default("Base")
  discordWebhookUrl  String?
  isPublic           Boolean    @default(true)
  activities         Activity[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Activity {
  id                 String   @id @default(cuid())
  stravaId           BigInt   @unique
  name               String
  type               String   @default("Run")
  startDate          DateTime
  distanceMeters     Float
  movingTimeSec      Int
  elapsedTimeSec     Int
  averageSpeed       Float
  maxSpeed           Float?
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageCadence     Float?
  totalElevationGain Float?
  splitsJson         Json?
  aiFeedback         String?  @db.Text
  trainingPhase      String   @default("Base")
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}
