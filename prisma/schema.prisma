// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(cuid())
  stravaAthleteId    BigInt     @unique
  username           String?    @unique
  fullName           String
  avatarUrl          String?
  stravaAccessToken  String
  stravaRefreshToken String
  tokenExpiresAt     Int
  goalDistance       String?
  goalTimeSec        Int?
  currentPbSec       Int?
  thresholdHr        Int?
  maxHr              Int        @default(190)
  thresholdPaceSec   Int?
  trainingPhase      String     @default("auto")
  targetRaceDate     DateTime?
  discordWebhookUrl  String?
  isPublic           Boolean    @default(true)
  preferredLanguage  String       @default("id")
  activities         Activity[]
  weeklyPlans        WeeklyPlan[]
  gears              Gear[]
  personalBests      PersonalBest[]
  coachConversations CoachConversation[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model PersonalBest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  distanceKey  String
  timeSeconds  Int
  paceSecPerKm Int
  activityId   String?
  activityName String
  achievedAt   DateTime
  updatedAt    DateTime @updatedAt

  @@unique([userId, distanceKey])
}

model Gear {
  id           String   @id @default(cuid())
  stravaGearId String   @unique
  name         String
  distanceKm   Float    @default(0)
  primary      Boolean  @default(false)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WeeklyPlan {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart      DateTime
  planJson       Json
  rescheduleNote String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, weekStart])
}

model Activity {
  id                 String   @id @default(cuid())
  stravaId           BigInt   @unique
  name               String
  type               String   @default("Run")
  startDate          DateTime
  distanceMeters     Float
  movingTimeSec      Int
  elapsedTimeSec     Int
  averageSpeed       Float
  maxSpeed           Float?
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageCadence     Float?
  totalElevationGain Float?
  splitsJson         Json?
  aiFeedback             String?  @db.Text
  trainingPhase          String   @default("Base")
  gearName               String?
  temperatureC           Float?
  humidityPct            Int?
  aqi                    Int?
  trafficFrictionScore   Int?
  easyRunDisciplineScore Int?
  contextTags            String[] @default([])
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachConversations     CoachConversation[]
  createdAt              DateTime            @default(now())
}

model CoachConversation {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  title      String
  messages   CoachMessage[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, updatedAt])
}

model CoachMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String            @db.Text
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}
